<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CurseForgeUpdateMonitor</RootNamespace>
    <AssemblyName>CurseForgeUpdateMonitor</AssemblyName>

    <!-- Framework-dependent single-file publish: small exe, but the .NET 10 Runtime
         must be installed on whichever machine runs it (see README.md for the full command).
         Output exe will be in bin/Release/net10.0/win-x64/publish/ -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Always request elevation (UAC prompt) so this exe runs at the same integrity level
         regardless of how it's launched (scheduled task, shortcut, manual double-click).
         See app.manifest for why: Process.MainModule access silently fails across integrity
         levels, which the crash monitor must never confuse with "process is not running." -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Bump this to match the git tag on every release (e.g. tag "v1.3.0" -> Version 1.3.0).
         Flows into the exe's file properties (Explorer -> right-click -> Properties -> Details)
         and is also logged at startup in Program.cs, so a deployed build's version can be
         confirmed without ever touching the csproj/source. -->
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
  </PropertyGroup>

</Project>
